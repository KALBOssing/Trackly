# PostgreSQL — used directly by `npm run dev` (via DATABASE_URL) and by
# docker-compose.yml (via the POSTGRES_* vars below) if you run the app in Docker too.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/trackly?schema=public"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres"
POSTGRES_DB="trackly"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-long-random-string" # generate: openssl rand -base64 32

# Supabase Storage (file uploads)
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# Email (Phase 2 — verification & password reset emails)
EMAIL_FROM="Trackly <no-reply@trackly.app>"
RESEND_API_KEY=""

# Cron (Phase 5 — deadline reminder emails, see /api/cron/deadline-reminders)
CRON_SECRET="replace-with-a-long-random-string"
