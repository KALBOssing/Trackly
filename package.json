    "prisma:seed": "tsx prisma/seed.ts",
    "prisma:studio": "prisma studio",
    "db:init": "prisma migrate dev --name init",
    "db:reset": "prisma migrate reset",
    "db:deploy": "prisma migrate deploy",
    "postinstall": "prisma generate"
  },
